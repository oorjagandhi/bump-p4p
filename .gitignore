### Build + tooling output ###
target/
**/__pycache__/
*.pyc

### nadia_scripts: run artifacts (regenerable; not research records) ###
scripts/nadia_scripts/_runlogs/
scripts/nadia_scripts/cmp_*.json
scripts/nadia_scripts/_bbc_baseline.py
scripts/nadia_scripts/scratchpad/**/target/
*.bak

### BBC verification: local Maven cache (hundreds of MB, regenerable)
.bbc_m2/

### BBC mining: search resume state. Deliberately NOT committed -- BBC_RESUME
### defaults to on, so a committed checkpoint would make a fresh run silently
### resume someone else's stale search instead of mining.
scripts/nadia_scripts/output/*_mine_checkpoint.jsonl
scripts/nadia_scripts/output/*_classify_checkpoint.jsonl
scripts/nadia_scripts/output/candidate_ranking_progress*.jsonl

# population probe resume state — same reason as the other checkpoints
scripts/nadia_scripts/output/population_probe_progress_*.jsonl

# hand-run verification workspace (shallow clones + build output)
.bbc_work/

# Cloned client repos inside harnesses: the driver and runner are tracked, the clone is not
scripts/nadia_scripts/scratchpad/**/repo/

# Per-state build output inside harnesses. Regenerated by run_state.sh (and bootstrap.sh)
# on every run; the RESULT line that matters is transcribed into the case JSON, which is
# what gets read. Covers *.build.log, *.deps.log, bootstrap*.log, state*.log alike.
scripts/nadia_scripts/scratchpad/**/*.log
scripts/nadia_scripts/scratchpad/**/*.cp
scripts/nadia_scripts/scratchpad/**/cp.txt
