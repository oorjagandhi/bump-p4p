<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>snakeyaml-mongoose-bbc</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- overridden per differential state: 1.33 (baseline) vs 2.0 (break boundary) -->
        <snakeyaml.version>1.33</snakeyaml.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <testFailureIgnore>true</testFailureIgnore>
                    <excludes>
                        <exclude>${bbc.test.exclude}</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <excludes>
                        <exclude>${bbc.main.exclude}</exclude>
                    </excludes>
                    <testExcludes>
                        <testExclude>${bbc.test.exclude}</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- STATES 1 & 2: parent code only (cross-version; the break demonstrator) -->
        <profile>
            <id>parent</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <bbc.main.exclude>**/YamlLoaderAdapted.java</bbc.main.exclude>
                <bbc.test.exclude>**/AdaptedBbcTest.java</bbc.test.exclude>
            </properties>
        </profile>
        <!-- STATE 3: adapted code only (uses 2.0-only setTagInspector) -->
        <profile>
            <id>adapted</id>
            <properties>
                <bbc.main.exclude>**/YamlLoaderParent.java</bbc.main.exclude>
                <bbc.test.exclude>**/ParentBbcTest.java</bbc.test.exclude>
            </properties>
        </profile>
    </profiles>
</project>
