<?xml version="1.0" encoding="UTF-8"?>
<!--
  MAVEN HARNESS (not the repo's real Gradle build) used only to compile the REAL
  production source under src/main/java and run one authored round-trip test that
  exercises the production UserPreferencesPersistence.retrieve() path.

  Why a harness: the repo builds with Gradle 8 (shadow + launch4j plugins) + SWT +
  Java 17 and ships no gradle wrapper at this commit; Gradle isn't installed here.
  The Java source is untouched — only the build tool is swapped and the xstream
  version is parameterised so we can run the 3-state differential:
    baseline  -Dxstream.version=1.4.17   (pre-adaptation code) -> PASS
    break     -Dxstream.version=1.4.20    (pre-adaptation code) -> FAIL (ForbiddenClassException)
    adapted   -Dxstream.version=1.4.20    (adaptation commit)   -> PASS
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.tvrenamer</groupId>
  <artifactId>tvrenamer-bbc-harness</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <xstream.version>1.4.20</xstream.version>
    <osgi.platform>win32.win32.x86_64</osgi.platform>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
      <version>3.124.0</version>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.thoughtworks.xstream</groupId>
      <artifactId>xstream</artifactId>
      <version>${xstream.version}</version>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.16.0</version>
    </dependency>
    <dependency>
      <groupId>xpp3</groupId>
      <artifactId>xpp3_min</artifactId>
      <version>1.1.4c</version>
    </dependency>
    <dependency>
      <groupId>xmlpull</groupId>
      <artifactId>xmlpull</artifactId>
      <version>1.1.3.1</version>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>4.12.0</version>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- run ONLY our authored BBC test, not the repo's other tests -->
          <includes><include>**/PreferencesBbcTest.java</include></includes>
          <!-- XStream reflection under Java 17 needs these opens (the real app
               runs with the equivalent); without them the JPMS blocks access to
               java.beans BEFORE the xstream security check can run. -->
          <argLine>
            --add-opens java.base/java.util=ALL-UNNAMED
            --add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens java.base/java.text=ALL-UNNAMED
            --add-opens java.base/java.io=ALL-UNNAMED
            --add-opens java.desktop/java.beans=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
